{
  "name": "@usenotra/web-mcp",
  "version": "0.1.0",
  "description": "One MCP interface over Exa, Firecrawl and context.dev web search + fetch, with LLM bias scoring",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "prepare": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "eval": "tsx --env-file-if-exists=.env evals/run.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "bin": {
    "web-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  }
}
